  "name": "Most Used Procedures in CUST SPP",
  "prepared_report": 0,
  "query": "SELECT\r\n    (procedure.procedure_name) AS procedure,\r\n    COUNT(pu.name)\r\n    \r\nFROM\r\n    `tabCustomer Support Ticket` AS ticket\r\nLEFT JOIN\r\n    `tabCustomer Support Procedure` AS procedure on procedure.name = ticket.procedure_name \r\n    \r\nWHERE ticket.creation BETWEEN %(from_date)s AND %(to_date)s\r\n\r\nGROUP BY \r\npu.name;",
