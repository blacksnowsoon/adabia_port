 "prepared_report": 0,
 "query": "SELECT\r\n    pu.procedure_name as \"Procedure Name\",\r\n    COUNT(pu.name) as \"Total Procedures\",\r\n    ticket.creation as \"Creation Date\"\r\nFROM\r\n    `tabCustomer Support Ticket` AS ticket\r\nLEFT JOIN\r\n    `tabCustomer Support Procedure` AS pu ON pu.name = ticket.procedure_name \r\nWHERE 1=1\r\nGROUP BY \r\n    pu.name",
