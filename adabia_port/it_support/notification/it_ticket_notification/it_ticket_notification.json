 "message": "\n<div style=\"margin: 2rem; background-color: bisque;\">\n    <h5>IT Ticket Number: {{ doc.name }}</h5>\n    <table style=\"outline: 1px solid gray; width: 100%; padding: 1rem;\" class=\"table table-bordered\">\n        <!-- Assign To -->\n        <tr>\n            {% if assign_to %}\n                <td><strong>Assigned To</strong></td>\n                <td>{{ assign_to }}</td>\n            {% endif %}\n        </tr>\n        <!-- Priority -->\n        <tr>\n            {% if doc.priority %}\n                <td><strong>Periority</strong></td>\n                <td>{{ doc.priority | default('Normal Priority') }}</td>\n            {% endif %}\n        </tr>\n        <!-- Employee -->\n        <tr>\n            {% if emp_name %}\n                <td><strong>To Employee</strong></td>\n                <td>{{ emp_name | default('Unknown Employee') }}</td>\n            {% endif %}\n        </tr>\n        <!-- Department -->\n        <tr>\n            {% if department %}\n                <td><strong>Department</strong></td>\n                <td>{{ department | default('Unknown Department') }}</td>\n            {% endif %}\n        </tr>\n        <!-- Locations -->\n        <tr>\n            {% if locations %}\n                <td><strong>Locations</strong></td>\n                <td>\n                    {% for location in locations %}\n                        {{ location | default('Unknown Location') }} \n                        <br>\n                    {% endfor %}\n                </td>\n            {% endif %}\n        </tr>\n        <!-- Devices -->\n        <tr>\n            {% if devices %}\n                <td><strong>Devices</strong></td>\n                 <td>\n                    {% for device in devices %}\n                        {{ device | default('Unknown Device') }}\n                        <br>\n                    {% endfor %}\n                    \n                </td>\n            {% endif %}\n        </tr>\n        <!-- Issues -->\n        <tr>\n            {% if issues %}\n            <td><strong>Issue About</strong></td>\n            <td>\n                {% for issue in issues %}\n                    {{ issue | default('Unknown Issue') }} \n                    <br>\n                {% endfor %}\n            </td>\n            {% endif %}\n        </tr>\n        <!-- Description -->\n        <tr>\n            {% if doc.description %}\n            <td><strong>Description</strong></td>\n            <td>{{ doc.description | default('No Issue Description Provided') }}</td>\n            {% endif %}\n        </tr>\n    </table>\n    <p class=\"text-center\">Please Take Your Action & Close the Ticket</p>\n    <p class=\"text-center\"><small>Thank You</small></p>\n    </section>\n\n</div>\n\n",
