 "message": "\n<div style=\"margin: 2rem;\">\n    <h5 class=\"text-center\">IT Ticket Number: {{ doc.name }}</h5>\n    <h6 class=\"text-center\">Created At : {{ doc.creation }}</h6>\n        {% if modified %}\n            <h5 class=\"text-center\">\u062a\u0645 \u062a\u0639\u062f\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0630\u0643\u0631\u0629</h5>\n            <h6 class=\"text-center\">Modified At : {{ doc.modified }}</h6>\n        {% endif %}\n    <table style=\"outline: 1px solid gray; width: 100%; padding: 1rem;  box-shadow: 3px 3px 6px 0px rgb(42, 42, 42);\" class=\"table table-bordered\">\n        <!-- Assign To -->\n        <tr>\n            {% if assign_to %}\n                <td><strong>Assigned To</strong></td>\n                <td>{{ assign_to }}</td>\n            {% endif %}\n        </tr>\n        <!-- Priority -->\n        <tr>\n            {% if doc.priority %}\n                <td><strong>Periority</strong></td>\n                <td>{{ doc.priority | default('Normal Priority') }}</td>\n            {% endif %}\n        </tr>\n        <!-- Employee -->\n        <tr>\n            {% if emp_name %}\n                <td><strong>To Employee</strong></td>\n                <td>{{ emp_name | default('Unknown Employee') }}</td>\n            {% endif %}\n        </tr>\n        <!-- Department -->\n        <tr>\n            {% if department %}\n                <td><strong>Department</strong></td>\n                <td>{{ department | default('Unknown Department') }}</td>\n            {% endif %}\n        </tr>\n        <!-- Locations -->\n        <tr>\n            {% if locations %}\n                <td><strong>Locations</strong></td>\n                <td>\n                    {% for location in locations %}\n                        {{ location | default('Unknown Location') }} \n                        <br>\n                    {% endfor %}\n                </td>\n            {% endif %}\n        </tr>\n        <!-- Devices -->\n        <tr>\n            {% if devices %}\n                <td><strong>Devices</strong></td>\n                 <td>\n                    {% for device in devices %}\n                        {{ device | default('Unknown Device') }}\n                        <br>\n                    {% endfor %}\n                    \n                </td>\n            {% endif %}\n        </tr>\n        <!-- company -->\n         <tr>\n            {% if company %}\n                <td><strong>To Company</strong></td>\n                <td>{{ company | default('Unknown Company') }}</td>\n            {% endif %}\n         </tr>\n        <!-- Issues -->\n        <tr>\n            {% if issues %}\n            <td><strong>Issue About</strong></td>\n            <td>\n                {% for issue in issues %}\n                    {{ issue | default('Unknown Issue') }} \n                    <br>\n                {% endfor %}\n            </td>\n            {% endif %}\n        </tr>\n        <!-- Description -->\n        <tr>\n            {% if doc.description %}\n                <td><strong>Description</strong></td>\n                <td>{{ doc.description | default('No Issue Description Provided') }}</td>\n            {% endif %}\n        </tr>\n        <tr>\n            {% if doc.what_implemented %}\n                <td><strong>What Implemented</strong></td>\n                <td>{{ doc.what_implemented | default('No Issue Description Provided') }}</td>\n            {% endif %}\n        </tr>\n    </table>\n    <p class=\"text-center text-red\">Please Take Your Action & Close the Ticket</p>\n    <p class=\"text-center text-blue\"><small>Thank You</small></p>\n    </section>\n</div>\n\n",
